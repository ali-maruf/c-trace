# C-Trace runs fully offline without this. Add a key to enable vision extraction (photos, Bangla bills)
# and LLM-written report narratives (always checked by the C-Trace number guard).
ANTHROPIC_API_KEY=
# Free alternative when ANTHROPIC_API_KEY is empty: any OpenAI-compatible host (default OpenRouter, gpt-oss-120b:free, text only)
OPENAI_API_KEY=
# CTRACE_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# CTRACE_OPENAI_MODEL=openai/gpt-oss-120b:free
# CTRACE_OPENAI_VISION=0
CTRACE_EXTRACTION_MODEL=claude-haiku-5-5
CTRACE_REPORT_MODEL=claude-sonnet-5-5
# Extraction cascade: reads below the confidence threshold are re-read by the escalation model ("" disables).
CTRACE_EXTRACTION_ESCALATION_MODEL=claude-sonnet-5-5
CTRACE_ESCALATE_BELOW=0.7
CTRACE_EXTRACTION_EFFORT=low
CTRACE_EXTRACTION_PROMPT=extract_bill/v2
# Server-side refusal fallback on models that support it: default | off
CTRACE_LLM_FALLBACKS=default
CTRACE_LLM_RATE_PER_MIN=20

# Database. Leave unset in development to use the embedded local Postgres (pgserver, .pgdata/).
# Supabase: Project Settings → Database → connection string (session pooler, port 5432).
DATABASE_URL=
# development | production. Outside development DATABASE_URL is required and dev tokens are refused.
CTRACE_ENV=development
# Supabase Auth: access tokens are verified against <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_URL=
