{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "nextjs"
    },
    "api": {
      "root": "./",
      "framework": "fastapi",
      "entrypoint": "asgi:app",
      "functions": {
        "asgi.py": {
          "maxDuration": 300,
          "includeFiles": "data/public/**",
          "excludeFiles": "{{apps,docs,ml,scripts,data/eval,data/storage,data/cache,.pgdata,.claude,.github,.hypothesis,**/tests}/**,.env*,data/training_fleet*,data/samples/ground_truth*,models/*/v1/*.joblib,infra/*.yml}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
